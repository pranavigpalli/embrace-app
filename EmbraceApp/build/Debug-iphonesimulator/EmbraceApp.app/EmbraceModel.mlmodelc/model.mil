            tensor<fp16, [1, 192]> avg_pool_cast_fp16 = reduce_mean(axes = avg_pool_axes_0, keep_dims = avg_pool_keep_dims_0, x = lstm_out_cast_fp16)[name = tensor<string, []>("avg_pool_cast_fp16")];
