            tensor<fp32, [300, 1, 192]> lstm_out_batch_first_0, tensor<fp32, [1, 192]> lstm_out_batch_first_1, tensor<fp32, [1, 192]> lstm_out_batch_first_2 = lstm(activation = lstm_out_batch_first_activation_0, bias = add_0, bias_back = add_1, cell_activation = lstm_out_batch_first_cell_activation_0, direction = lstm_out_batch_first_direction_0, initial_c = lstm_out_batch_first_lstm_h0_reshaped, initial_h = lstm_out_batch_first_lstm_h0_reshaped, output_sequence = lstm_out_batch_first_output_sequence_0, recurrent_activation = lstm_out_batch_first_recurrent_activation_0, weight_hh = concat_5, weight_hh_back = concat_7, weight_ih = concat_4, weight_ih_back = concat_6, x = transpose_0_cast_fp16_to_fp32)[name = tensor<string, []>("lstm_out_batch_first")];
